{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Secrets": {
        "Provider": "AWS",
        "Mappings": {
            "JwtAccessTokenSecret": "JwtAccessTokenSecret",
            "JwtAccessTokenTtl": "JwtAccessTokenTtl",
            "JwtAccessTokenTtlForManagers": "JwtAccessTokenTtlForManagers",
            "JwtRefreshTokenSecret": "JwtRefreshTokenSecret",
            "JwtRefreshTokenTtl": "JwtRefreshTokenTtl",
            "JwtRefreshTokenTtlForManagers": "JwtRefreshTokenTtlForManagers",
            "JwtIssuer": "JwtIssuer",
            "JwtAudience": "JwtAudience",
            "RequestSecurityKey": "RequestSecurityKey",
            "DatabaseConnectionString": "DatabaseConnectionString"
        }
    }
}
