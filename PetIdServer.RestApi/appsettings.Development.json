{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Information"
        }
    },
    "AllowedHosts": "*",
    "Secrets": {
        "Provider": "Environment",
        "Mappings": {
            "JwtAccessTokenSecret": "JWT_AT_SECRET",
            "JwtAccessTokenTtl": "JWT_AT_TTL",
            "JwtAccessTokenTtlForManagers": "JWT_AT_TTL_MANAGER",
            "JwtRefreshTokenSecret": "JWT_RT_SECRET",
            "JwtRefreshTokenTtl": "JWT_RT_TTL",
            "JwtRefreshTokenTtlForManagers": "JWT_RT_TTL_MANAGER",
            "JwtIssuer": "JWT_ISSUER",
            "JwtAudience": "JWT_AUDIENCE",
            "RequestSecurityKey": "REQ_SECURITY_KEY",
            "DatabaseConnectionString": "DB_CONNECTION_STRING"
        }
    }
}
